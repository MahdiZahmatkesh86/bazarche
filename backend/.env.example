# Bazaarche Backend — Template
# این فایل رو کپی کن به .env یا از node setup-env.js استفاده کن

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:8080,http://127.0.0.1:8080

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=bazaarche

JWT_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=30d

ADMIN_NAME=مدیر
ADMIN_EMAIL=admin@bazaarche.local
ADMIN_PHONE=
ADMIN_PASSWORD=
