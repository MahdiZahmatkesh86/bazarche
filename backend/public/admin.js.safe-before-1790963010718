async function renderCategories(root){
  root.innerHTML = `
    <div class="adm-sec-head">
      <h2>دسته‌بندی‌ها</h2>
      <div class="adm-sec-actions">
        <button class="adm-btn primary" id="btnNewCat">${ic('plus',18)} دسته‌ی جدید</button>
