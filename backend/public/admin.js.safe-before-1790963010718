        <td class="col-actions"><div class="adm-tbl-actions">
          <button class="adm-iconbtn-sm" data-role="${u.id}" data-cur="${u.role}" title="تغییر نقش">${ic('user',16)}</button>
          <button class="adm-iconbtn-sm" data-toggle="${u.id}" title="فعال/غیرفعال">${u.isActive?ic('toggleOn',16):ic('toggleOff',16)}</button>
          <button class="adm-iconbtn-sm danger" data-del="${u.id}" title="حذف">${ic('trash',16)}</button>
        </div></td>
      </tr>
    `).join('');
    tbody.querySelectorAll('[data-role]').forEach(b=>b.onclick=()=>changeRole(+b.dataset.role, b.dataset.cur));
    tbody.querySelectorAll('[data-toggle]').forEach(b=>b.onclick=()=>toggleUser(+b.dataset.toggle));
    tbody.querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>deleteUser(+b.dataset.del));
  };

  const load = async ()=>{
    tbody.innerHTML = '<tr><td colspan="6"><div class="adm-sk adm-sk-row"></div></td></tr>';
    try{
      const res = await apiGet('/users?limit=100');
      all = res.items || [];
      $('#usrCount').textContent = fa(all.length) + ' کاربر';
      renderRows(all);
    }catch(e){ toast('خطا: '+e.message,'err'); }
