              <rect x="3" y="3" width="58" height="58" rx="18" fill="url(#invWine)"/>
              <path d="M20 27 L44 27 L41.5 47 L22.5 47 Z" fill="none" stroke="#E2C88C" stroke-width="2.4" stroke-linejoin="round"/>
