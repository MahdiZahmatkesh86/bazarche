    if(!Number(F.price)){ toast('قیمت فروش را وارد کنید.', 'warn'); return; }

    const payload = {
      name: String(F.name).trim(),
      sku: String(F.sku || '').trim() || null,
      brand: String(F.brand).trim(),
      category: F.category,
      price: Number(String(F.price).replace(/[^\d]/g,'')) || 0,
      purchasePrice: Number(String(F.purchasePrice).replace(/[^\d]/g,'')) || 0,
      off: Math.min(90, Math.max(0, Number(F.off) || 0)),
      stock: Number(String(F.stock).replace(/[^\d]/g,'')) || 0,
      minStock: Number(String(F.minStock).replace(/[^\d]/g,'')) || 0,
      weight: Number(String(F.weight).replace(/[^\d]/g,'')) || 0,
      dimensions: F.dimensions || '',
      art: F.art || 'book',
      description: F.description || '',
      shortDescription: F.shortDescription || '',
      videoUrl: F.videoUrl || '',
      warranty: F.warranty || '',
      metaTitle: F.metaTitle || '',
      metaDescription: F.metaDescription || '',
      images: F.images.filter(function(u){ return u && String(u).trim(); }),
      features: F.features.filter(function(x){ return x && String(x).trim(); }),
      sizes: F.sizes.filter(function(x){ return x && String(x).trim(); }),
      colors: F.colors.filter(function(c){ return c && c.name; }),
      specs: F.specs.filter(function(s){ return s && s.key && s.value; }),
      isActive: !!F.isActive
    };

    const old = saveBtn.textContent;
    saveBtn.disabled = true; saveBtn.textContent = 'در حال ذخیره...';
    try{
      if(id) await apiPut('/products/' + id, payload);
      else   await apiPost('/products', payload);
      toast(id ? 'محصول ویرایش شد.' : 'محصول اضافه شد.', 'ok');
      closeModal();
      if(state.refresh) state.refresh();
    }catch(e){
      toast('خطا: ' + e.message, 'err');
    }finally{
      saveBtn.disabled = false; saveBtn.textContent = old;
    }
  };
}

