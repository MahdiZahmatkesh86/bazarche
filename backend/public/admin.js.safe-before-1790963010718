  $('#usrSearch').addEventListener('input', e=>{
    const q = e.target.value.trim().toLowerCase();
    if(!q){ renderRows(all); return; }
    renderRows(all.filter(u=>(u.name+' '+u.email+' '+u.phone).toLowerCase().includes(q)));
  });

  state.refresh = load;
  load();
}

async function changeRole(id, cur){
  const next = cur==='admin' ? 'user' : 'admin';
  const ok = await confirmDialog({
    title: next==='admin'?'ارتقا به ادمین':'حذف دسترسی ادمین',
    message:'نقش کاربر تغییر می‌کند. مطمئنید؟',
    confirmText:'تأیید', danger:false
  });
  if(!ok) return;
  try{
    await apiPatch('/users/'+id+'/role', { role:next });
    toast('نقش کاربر تغییر کرد.','ok');
    if(state.refresh) state.refresh();
  }catch(e){ toast('خطا: '+e.message,'err'); }
}
